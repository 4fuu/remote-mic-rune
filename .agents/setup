#!/usr/bin/env bash
# Orb setup: Rust toolchain + Windows cross targets + host-test system libs.
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
fi
source "$HOME/.cargo/env"

rustup target add x86_64-pc-windows-msvc x86_64-pc-windows-gnu

if ! command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq mingw-w64
fi

# bindgen (frida-gum-sys build script) needs libclang. Cross-checking the
# Windows targets also needs the cross-clang include path, set per command:
#   LIBCLANG_PATH=/usr/lib/llvm-14/lib
#   BINDGEN_EXTRA_CLANG_ARGS='--target=x86_64-w64-windows-gnu -isystem /usr/lib/llvm-14/lib/clang/14.0.6/include'
if [ ! -e /usr/lib/llvm-14/lib/libclang.so ] && [ ! -e /usr/lib/llvm-15/lib/libclang.so ]; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq libclang-dev
fi

# System libs needed to LINK rc-app host tests (Rune's Linux UI backend:
# winit/x11/wayland). Not needed for cross-checking or cross-building.
if ! pkg-config --exists xkbcommon 2>/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq libxkbcommon-dev libwayland-dev libx11-dev
fi
